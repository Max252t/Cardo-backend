HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=20s
SHUTDOWN_DRAIN_DELAY=3s
TRUSTED_PROXIES=172.28.0.0/16

POSTGRES_PASSWORD=cardo
DATABASE_URL=postgres://cardo:cardo@postgres:5432/cardo?sslmode=disable
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s
MIGRATE_ON_START=true

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ISSUER=cardo
JWT_AUDIENCE=cardo-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

SINGLE_INSTANCE=false
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=1m

ARGON2_MAX_CONCURRENT=0
ARGON2_ACQUIRE_TIMEOUT=2s

WS_ALLOWED_ORIGINS=

METRICS_ADDR=:9091

GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=info
